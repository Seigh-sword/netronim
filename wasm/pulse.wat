(module
  (memory (export "memory") 3)
  (func $tri (param $v i32) (result i32)
    (local $t i32)
    (local.set $t (i32.and (local.get $v) (i32.const 255)))
    (if (result i32) (i32.gt_u (local.get $t) (i32.const 127))
      (then (i32.sub (i32.const 255) (local.get $t))) (else (local.get $t))))
  (func (export "init") (param $w i32) (param $h i32))
  (func (export "render") (param $time i32) (param $px i32) (param $py i32) (result i32)
    (local $x i32) (local $y i32) (local $p i32) (local $a i32) (local $b i32) (local $c i32) (local $r i32) (local $g i32) (local $bl i32) (local $pixel i32)
    (loop $yy
      (local.set $x (i32.const 0))
      (loop $xx
        (local.set $a (call $tri (i32.add (i32.add (i32.mul (local.get $x) (i32.const 2)) (local.get $time)) (local.get $px))))
        (local.set $b (call $tri (i32.sub (i32.add (i32.mul (local.get $y) (i32.const 3)) (i32.shr_s (local.get $time) (i32.const 1))) (local.get $py))))
        (local.set $c (call $tri (i32.add (i32.add (local.get $x) (local.get $y)) (i32.shl (local.get $time) (i32.const 1)))))
        (local.set $r (i32.shr_s (i32.add (local.get $a) (local.get $c)) (i32.const 1)))
        (local.set $g (i32.shr_s (local.get $b) (i32.const 2)))
        (local.set $bl (i32.shr_s (i32.add (local.get $b) (local.get $a)) (i32.const 1)))
        (local.set $pixel (i32.or (i32.or (local.get $r) (i32.shl (local.get $g) (i32.const 8))) (i32.or (i32.shl (local.get $bl) (i32.const 16)) (i32.const 0xff000000))))
        (local.set $p (i32.shl (i32.add (i32.mul (local.get $y) (i32.const 256)) (local.get $x)) (i32.const 2)))
        (i32.store (local.get $p) (local.get $pixel))
        (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $xx (i32.lt_u (local.get $x) (i32.const 256))))
      (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $yy (i32.lt_u (local.get $y) (i32.const 160))))
    (i32.const 0))
)
