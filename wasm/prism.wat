(module
  (memory (export "memory") 2)
  (global $seed (mut i32) (i32.const 731))
  (func $random (result f32)
    (global.set $seed (i32.add (i32.mul (global.get $seed) (i32.const 1664525)) (i32.const 1013904223)))
    (f32.sub (f32.div (f32.convert_i32_u (i32.shr_u (global.get $seed) (i32.const 8))) (f32.const 8388608)) (f32.const 1)))
  (func (export "init") (param $count i32)
    (local $i i32) (local $p i32) (local $x f32) (local $y f32)
    (loop $loop
      (local.set $p (i32.shl (local.get $i) (i32.const 4)))
      (local.set $x (call $random)) (local.set $y (call $random))
      (f32.store (local.get $p) (f32.mul (local.get $x) (f32.const 1.6)))
      (f32.store offset=4 (local.get $p) (local.get $y))
      (f32.store offset=8 (local.get $p) (f32.mul (local.get $y) (f32.const -0.16)))
      (f32.store offset=12 (local.get $p) (f32.mul (local.get $x) (f32.const 0.16)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $loop (i32.lt_u (local.get $i) (local.get $count)))))
  (func (export "step") (param $count i32) (param $dt f32) (param $px f32) (param $py f32) (param $active i32)
    (local $i i32) (local $p i32) (local $x f32) (local $y f32) (local $vx f32) (local $vy f32) (local $dx f32) (local $dy f32) (local $r f32) (local $force f32)
    (loop $loop
      (local.set $p (i32.shl (local.get $i) (i32.const 4)))
      (local.set $x (f32.load (local.get $p))) (local.set $y (f32.load offset=4 (local.get $p)))
      (local.set $vx (f32.load offset=8 (local.get $p))) (local.set $vy (f32.load offset=12 (local.get $p)))
      (local.set $r (f32.add (f32.add (f32.mul (local.get $x) (local.get $x)) (f32.mul (local.get $y) (local.get $y))) (f32.const 0.08)))
      (local.set $vx (f32.sub (local.get $vx) (f32.mul (f32.div (local.get $x) (local.get $r)) (f32.mul (local.get $dt) (f32.const 0.035)))))
      (local.set $vy (f32.sub (local.get $vy) (f32.mul (f32.div (local.get $y) (local.get $r)) (f32.mul (local.get $dt) (f32.const 0.035)))))
      (if (local.get $active) (then
        (local.set $dx (f32.sub (local.get $x) (local.get $px))) (local.set $dy (f32.sub (local.get $y) (local.get $py)))
        (local.set $r (f32.add (f32.add (f32.mul (local.get $dx) (local.get $dx)) (f32.mul (local.get $dy) (local.get $dy))) (f32.const 0.006)))
        (local.set $force (f32.div (f32.mul (local.get $dt) (f32.const 0.012)) (local.get $r)))
        (local.set $vx (f32.add (local.get $vx) (f32.mul (local.get $dx) (local.get $force))))
        (local.set $vy (f32.add (local.get $vy) (f32.mul (local.get $dy) (local.get $force))))))
      (local.set $vx (f32.mul (local.get $vx) (f32.const 0.999))) (local.set $vy (f32.mul (local.get $vy) (f32.const 0.999)))
      (local.set $x (f32.add (local.get $x) (f32.mul (local.get $vx) (local.get $dt))))
      (local.set $y (f32.add (local.get $y) (f32.mul (local.get $vy) (local.get $dt))))
      (if (f32.gt (f32.abs (local.get $x)) (f32.const 1.7)) (then (local.set $x (f32.mul (local.get $x) (f32.const -0.95))) (local.set $vx (f32.neg (local.get $vx)))))
      (if (f32.gt (f32.abs (local.get $y)) (f32.const 0.96)) (then (local.set $y (f32.mul (local.get $y) (f32.const -0.95))) (local.set $vy (f32.neg (local.get $vy)))))
      (f32.store (local.get $p) (local.get $x)) (f32.store offset=4 (local.get $p) (local.get $y))
      (f32.store offset=8 (local.get $p) (local.get $vx)) (f32.store offset=12 (local.get $p) (local.get $vy))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $loop (i32.lt_u (local.get $i) (local.get $count)))))
)
